# -------------------------------------------------------------
# SIGO-DENTAL: VARIABLES DE ENTORNO DEL SISTEMA
# -------------------------------------------------------------

# Entorno y Puertos
NODE_ENV=development
PORT=3000
FRONTEND_PORT=80

# PostgreSQL 16
POSTGRES_DB=sigo_dental_db
POSTGRES_USER=sigo_user
POSTGRES_PASSWORD=sigo_password_secure
DB_PORT=5432
DATABASE_URL=postgresql://sigo_user:sigo_password_secure@localhost:5432/sigo_dental_db?schema=public

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# JWT y Seguridad
JWT_SECRET=sigo_jwt_super_secret_key_change_in_prod_min_32_chars
JWT_REFRESH_SECRET=sigo_jwt_refresh_super_secret_key_change_in_prod
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=8h
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MinIO / S3 Storage
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_key_2026
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret_key_2026
S3_BUCKET=sigo-dental-docs
S3_REGION=us-east-1

# ClamAV Antivirus
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

