datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. SUBDOMINIO: SEGURIDAD, ROLES Y ACCESOS DINÁMICOS
// ==========================================

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  lectura     Boolean  @default(true)
  escritura   Boolean  @default(false)
  borrado     Boolean  @default(false)
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users       User[]
  roleOptions RoleMenuOption[]

  @@map("roles")
}

model Branch {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(100)
  address     String?  @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users        User[]
  dentalChairs DentalChair[]
  patients     Patient[]
  appointments Appointment[]
  cashShifts   CashShift[]

  @@map("branches")
}

model DentalChair {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  code        String   @db.VarChar(20)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch       Branch        @relation(fields: [branchId], references: [id])
  appointments Appointment[]

  @@unique([branchId, code])
  @@map("dental_chairs")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  documentType   String    @default("DNI") @map("document_type") @db.VarChar(20)
  documentNumber String    @unique @map("document_number") @db.VarChar(30)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  email          String    @unique @db.VarChar(120)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  mfaSecret      String?   @map("mfa_secret") @db.VarChar(100)
  isMfaEnabled   Boolean   @default(false) @map("is_mfa_enabled")
  isActive       Boolean   @default(true) @map("is_active")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  role                 Role          @relation(fields: [roleId], references: [id])
  branch               Branch        @relation(fields: [branchId], references: [id])
  doctorAppointments   Appointment[]   @relation("DoctorAppointments")
  doctorEvolutionNotes EvolutionNote[] @relation("DoctorEvolutionNotes")
  doctorPrescriptions  Prescription[]  @relation("DoctorPrescriptions")
  cashShifts           CashShift[]     @relation("CashierShifts")
  invoices             Invoice[]     @relation("CashierInvoices")
  auditLogs            AuditLog[]

  @@map("users")
}

model MenuOption {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  optionCode   String    @unique @map("option_code") @db.VarChar(50)
  title        String    @db.VarChar(100)
  frontendRoute String   @map("frontend_route") @db.VarChar(150)
  materialIcon String    @map("material_icon") @db.VarChar(50)
  orderIndex   Int       @default(0) @map("order_index")
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  parent          MenuOption?          @relation("MenuHierarchy", fields: [parentId], references: [id])
  children        MenuOption[]         @relation("MenuHierarchy")
  roleOptions     RoleMenuOption[]
  optionEndpoints MenuOptionEndpoint[]

  @@map("menu_options")
}

model RoleMenuOption {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  menuOptionId String    @map("menu_option_id") @db.Uuid
  lectura      Boolean   @default(true)
  escritura    Boolean   @default(false)
  borrado      Boolean   @default(false)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuOption MenuOption @relation(fields: [menuOptionId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuOptionId])
  @@map("role_menu_options")
}

model Endpoint {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  httpMethod   String    @map("http_method") @db.VarChar(10) // GET, POST, PUT, DELETE, PATCH
  apiPath      String    @map("api_path") @db.VarChar(200)
  permission   String    @db.VarChar(50)
  domainModule String    @map("domain_module") @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  optionEndpoints MenuOptionEndpoint[]

  @@unique([httpMethod, apiPath])
  @@map("endpoints")
}

model MenuOptionEndpoint {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuOptionId String @map("menu_option_id") @db.Uuid
  endpointId   String @map("endpoint_id") @db.Uuid

  menuOption MenuOption @relation(fields: [menuOptionId], references: [id], onDelete: Cascade)
  endpoint   Endpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([menuOptionId, endpointId])
  @@map("menu_option_endpoints")
}

// ==========================================
// 2. SUBDOMINIO: PACIENTES Y EXPEDIENTE
// ==========================================

model Patient {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  documentType   String    @default("DNI") @map("document_type") @db.VarChar(20)
  documentNumber String    @unique @map("document_number") @db.VarChar(30)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  birthDate      DateTime  @map("birth_date") @db.Date
  gender         String    @db.VarChar(20)
  email          String?   @db.VarChar(120)
  phone          String?   @db.VarChar(50)
  address        String?   @db.VarChar(255)
  emergencyData  Json?     @map("emergency_data")
  legalTutorData Json?     @map("legal_tutor_data")
  insuranceData  Json?     @map("insurance_data")
  isActive       Boolean   @default(true) @map("is_active")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  branch         Branch          @relation(fields: [branchId], references: [id])
  clinicalRecord ClinicalRecord?
  appointments   Appointment[]
  invoices       Invoice[]

  @@map("patients")
}

model ClinicalRecord {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId            String    @unique @map("patient_id") @db.Uuid
  recordNumber         String    @unique @map("record_number") @db.VarChar(30)
  pathologiesEncrypted String?   @map("pathologies_encrypted") @db.Text // AES-256-GCM
  allergiesEncrypted   String?   @map("allergies_encrypted") @db.Text   // AES-256-GCM
  visibleAlerts        Json?     @map("visible_alerts")
  initialOdontogram    Json?     @map("initial_odontogram")
  evolutionaryOdontogram Json?   @map("evolutionary_odontogram")
  periodontogramData   Json?     @map("periodontogram_data")
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  patient          Patient          @relation(fields: [patientId], references: [id])
  evolutionNotes   EvolutionNote[]
  informedConsents InformedConsent[]
  prescriptions    Prescription[]

  @@map("clinical_records")
}

model EvolutionNote {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalRecordId String    @map("clinical_record_id") @db.Uuid
  doctorId         String    @map("doctor_id") @db.Uuid
  subjective       String    @db.Text
  objective        String    @db.Text
  assessment       String    @db.Text // Diagnósticos y CIE-10 Odontológico
  plan             String    @db.Text // Plan de tratamiento / receta
  isLocked         Boolean   @default(false) @map("is_locked")
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz
  isAdenda         Boolean   @default(false) @map("is_adenda")
  originalNoteId   String?   @map("original_note_id") @db.Uuid
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  clinicalRecord   ClinicalRecord  @relation(fields: [clinicalRecordId], references: [id])
  doctor           User            @relation("DoctorEvolutionNotes", fields: [doctorId], references: [id])
  originalNote     EvolutionNote?  @relation("NoteAdendas", fields: [originalNoteId], references: [id])
  adendas          EvolutionNote[] @relation("NoteAdendas")

  @@map("evolution_notes")
}

model InformedConsent {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalRecordId   String    @map("clinical_record_id") @db.Uuid
  procedureName      String    @map("procedure_name") @db.VarChar(150)
  risksDescription   String    @map("risks_description") @db.Text
  patientSignature   String?   @map("patient_signature") @db.Text
  otpCode            String?   @map("otp_code") @db.VarChar(10)
  isSigned           Boolean   @default(false) @map("is_signed")
  signedAt           DateTime? @map("signed_at") @db.Timestamptz
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  clinicalRecord     ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])

  @@map("informed_consents")
}

model Prescription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalRecordId   String    @map("clinical_record_id") @db.Uuid
  doctorId           String    @map("doctor_id") @db.Uuid
  items              Json      // Medicamentos prescritos
  instructions       String?   @db.Text
  qrVerificationCode String    @unique @map("qr_verification_code") @db.VarChar(100)
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  clinicalRecord     ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])
  doctor             User           @relation("DoctorPrescriptions", fields: [doctorId], references: [id])

  @@map("prescriptions")
}

// ==========================================
// 3. SUBDOMINIO: AGENDA Y CITAS
// ==========================================

model Appointment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  doctorId        String    @map("doctor_id") @db.Uuid
  chairId         String    @map("chair_id") @db.Uuid
  startDateTime   DateTime  @map("start_date_time") @db.Timestamptz
  endDateTime     DateTime  @map("end_date_time") @db.Timestamptz
  status          String    @default("PROGRAMADO") @db.VarChar(30) // PROGRAMADO, CONFIRMADO, EN_SALA, EN_ATENCION, ATENDIDO, CANCELADO, NO_SHOW
  reason          String?   @db.VarChar(255)
  waitingMinutes  Int       @default(0) @map("waiting_minutes")
  reminderSent48h Boolean   @default(false) @map("reminder_sent_48h")
  reminderSent24h Boolean   @default(false) @map("reminder_sent_24h")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  branch  Branch      @relation(fields: [branchId], references: [id])
  patient Patient     @relation(fields: [patientId], references: [id])
  doctor  User        @relation("DoctorAppointments", fields: [doctorId], references: [id])
  chair   DentalChair @relation(fields: [chairId], references: [id])
  invoices Invoice[]

  @@map("appointments")
}

// ==========================================
// 4. SUBDOMINIO: FACTURACIÓN Y CAJA CIEGA
// ==========================================

model CashShift {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId             String    @map("branch_id") @db.Uuid
  cashierId            String    @map("cashier_id") @db.Uuid
  openingTime          DateTime  @default(now()) @map("opening_time") @db.Timestamptz
  closingTime          DateTime? @map("closing_time") @db.Timestamptz
  openingBalance       Decimal   @map("opening_balance") @db.Decimal(12, 2)
  theoreticalBalance   Decimal?  @map("theoretical_balance") @db.Decimal(12, 2)
  declaredPhysicalBalance Decimal? @map("declared_physical_balance") @db.Decimal(12, 2)
  discrepancy          Decimal?  @db.Decimal(12, 2)
  status               String    @default("ABIERTA") @db.VarChar(20) // ABIERTA, CERRADA_CIEGA, AUDITADA
  notes                String?   @db.Text
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz

  branch  Branch @relation(fields: [branchId], references: [id])
  cashier User   @relation("CashierShifts", fields: [cashierId], references: [id])

  @@map("cash_shifts")
}

model Invoice {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String?  @map("appointment_id") @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  cashierId    String    @map("cashier_id") @db.Uuid
  invoiceType  String    @map("invoice_type") @db.VarChar(30) // FACTURA, BOLETA, NOTA_CREDITO
  seriesNumber String    @unique @map("series_number") @db.VarChar(50)
  subtotal     Decimal   @db.Decimal(12, 2)
  tax          Decimal   @db.Decimal(12, 2)
  total        Decimal   @db.Decimal(12, 2)
  fiscalStatus String    @default("EMITIDO") @map("fiscal_status") @db.VarChar(30)
  cufeCae      String?   @map("cufe_cae") @db.VarChar(100)
  xmlUrl       String?   @map("xml_url") @db.VarChar(255)
  pdfUrl       String?   @map("pdf_url") @db.VarChar(255)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  patient        Patient         @relation(fields: [patientId], references: [id])
  cashier        User            @relation("CashierInvoices", fields: [cashierId], references: [id])
  paymentDetails PaymentDetail[]

  @@map("invoices")
}

model PaymentDetail {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String    @map("invoice_id") @db.Uuid
  paymentMethod   String    @map("payment_method") @db.VarChar(30) // EFECTIVO, TARJETA, TRANSFERENCIA
  amount          Decimal   @db.Decimal(12, 2)
  voucherReference String?  @map("voucher_reference") @db.VarChar(100)
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_details")
}

// ==========================================
// 5. SUBDOMINIO: AUDITORÍA FORENSE APPEND-ONLY
// ==========================================

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  userRole       String?  @map("user_role") @db.VarChar(50)
  action         String   @db.VarChar(50) // LOGIN, READ, WRITE, UPDATE, SOFT_DELETE, EXPORT
  resource       String   @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.Uuid
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  eventTimestamp DateTime @default(now()) @map("event_timestamp") @db.Timestamptz
  metadata       Json?
  integrityHash  String?  @map("integrity_hash") @db.VarChar(64) // SHA-256

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

