datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. SUBDOMINIO: SEGURIDAD, ROLES Y ACCESOS DINÁMICOS
// ==========================================

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  lectura     Boolean  @default(true)
  escritura   Boolean  @default(false)
  borrado     Boolean  @default(false)
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users       User[]
  roleOptions RoleMenuOption[]

  @@map("roles")
}

model Branch {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(100)
  address     String?  @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users        User[]
  dentalChairs DentalChair[]
  patients     Patient[]
  appointments Appointment[]
  cashShifts   CashShift[]

  @@map("branches")
}

model DentalChair {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  code        String   @db.VarChar(20)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch       Branch        @relation(fields: [branchId], references: [id])
  appointments Appointment[]

  @@unique([branchId, code])
  @@map("dental_chairs")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  documentType   String    @default("DNI") @map("document_type") @db.VarChar(20)
  documentNumber String    @unique @map("document_number") @db.VarChar(30)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  email          String    @unique @db.VarChar(120)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  mfaSecret      String?   @map("mfa_secret") @db.VarChar(100)
  isMfaEnabled   Boolean   @default(false) @map("is_mfa_enabled")
  isActive       Boolean   @default(true) @map("is_active")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  role                 Role          @relation(fields: [roleId], references: [id])
  branch               Branch        @relation(fields: [branchId], references: [id])
  doctorAppointments   Appointment[]   @relation("DoctorAppointments")
  doctorEvolutionNotes EvolutionNote[] @relation("DoctorEvolutionNotes")
  doctorPrescriptions  Prescription[]  @relation("DoctorPrescriptions")
  doctorTreatmentPlans TreatmentPlan[] @relation("DoctorTreatmentPlans")
  commissionRules      DoctorCommissionRule[]
  commissionSettlements DoctorCommissionSettlement[]
  cashShifts           CashShift[]     @relation("CashierShifts")
  invoices             Invoice[]     @relation("CashierInvoices")
  auditLogs            AuditLog[]

  @@map("users")
}

model MenuOption {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId     String?   @map("parent_id") @db.Uuid
  optionCode   String    @unique @map("option_code") @db.VarChar(50)
  title        String    @db.VarChar(100)
  frontendRoute String   @map("frontend_route") @db.VarChar(150)
  materialIcon String    @map("material_icon") @db.VarChar(50)
  orderIndex   Int       @default(0) @map("order_index")
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  parent          MenuOption?          @relation("MenuHierarchy", fields: [parentId], references: [id])
  children        MenuOption[]         @relation("MenuHierarchy")
  roleOptions     RoleMenuOption[]
  optionEndpoints MenuOptionEndpoint[]

  @@map("menu_options")
}

model RoleMenuOption {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  menuOptionId String    @map("menu_option_id") @db.Uuid
  lectura      Boolean   @default(true)
  escritura    Boolean   @default(false)
  borrado      Boolean   @default(false)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuOption MenuOption @relation(fields: [menuOptionId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuOptionId])
  @@map("role_menu_options")
}

model Endpoint {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  httpMethod   String    @map("http_method") @db.VarChar(10) // GET, POST, PUT, DELETE, PATCH
  apiPath      String    @map("api_path") @db.VarChar(200)
  permission   String    @db.VarChar(50)
  domainModule String    @map("domain_module") @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  optionEndpoints MenuOptionEndpoint[]

  @@unique([httpMethod, apiPath])
  @@map("endpoints")
}

model MenuOptionEndpoint {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuOptionId String @map("menu_option_id") @db.Uuid
  endpointId   String @map("endpoint_id") @db.Uuid

  menuOption MenuOption @relation(fields: [menuOptionId], references: [id], onDelete: Cascade)
  endpoint   Endpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([menuOptionId, endpointId])
  @@map("menu_option_endpoints")
}

// ==========================================
// 2. SUBDOMINIO: PACIENTES Y EXPEDIENTE
// ==========================================

model Patient {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  documentType   String    @default("DNI") @map("document_type") @db.VarChar(20)
  documentNumber String    @unique @map("document_number") @db.VarChar(30)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  birthDate      DateTime  @map("birth_date") @db.Date
  gender         String    @db.VarChar(20)
  email          String?   @db.VarChar(120)
  phone          String?   @db.VarChar(50)
  address        String?   @db.VarChar(255)
  emergencyData  Json?     @map("emergency_data")
  legalTutorData Json?     @map("legal_tutor_data")
  insuranceData  Json?     @map("insurance_data")
  isActive       Boolean   @default(true) @map("is_active")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  branch         Branch          @relation(fields: [branchId], references: [id])
  clinicalRecord ClinicalRecord?
  appointments   Appointment[]
  invoices       Invoice[]
  treatmentPlans TreatmentPlan[]

  @@map("patients")
}

model ClinicalRecord {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId            String    @unique @map("patient_id") @db.Uuid
  recordNumber         String    @unique @map("record_number") @db.VarChar(30)
  pathologiesEncrypted String?   @map("pathologies_encrypted") @db.Text // AES-256-GCM
  allergiesEncrypted   String?   @map("allergies_encrypted") @db.Text   // AES-256-GCM
  visibleAlerts        Json?     @map("visible_alerts")
  initialOdontogram    Json?     @map("initial_odontogram")
  evolutionaryOdontogram Json?   @map("evolutionary_odontogram")
  periodontogramData   Json?     @map("periodontogram_data")
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  patient          Patient          @relation(fields: [patientId], references: [id])
  evolutionNotes   EvolutionNote[]
  informedConsents InformedConsent[]
  prescriptions    Prescription[]

  @@map("clinical_records")
}

model EvolutionNote {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalRecordId String    @map("clinical_record_id") @db.Uuid
  doctorId         String    @map("doctor_id") @db.Uuid
  subjective       String    @db.Text
  objective        String    @db.Text
  assessment       String    @db.Text // Diagnósticos y CIE-10 Odontológico
  plan             String    @db.Text // Plan de tratamiento / receta
  isLocked         Boolean   @default(false) @map("is_locked")
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz
  isAdenda         Boolean   @default(false) @map("is_adenda")
  originalNoteId   String?   @map("original_note_id") @db.Uuid
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  clinicalRecord   ClinicalRecord  @relation(fields: [clinicalRecordId], references: [id])
  doctor           User            @relation("DoctorEvolutionNotes", fields: [doctorId], references: [id])
  originalNote     EvolutionNote?  @relation("NoteAdendas", fields: [originalNoteId], references: [id])
  adendas          EvolutionNote[] @relation("NoteAdendas")

  @@map("evolution_notes")
}

model InformedConsent {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalRecordId   String    @map("clinical_record_id") @db.Uuid
  procedureName      String    @map("procedure_name") @db.VarChar(150)
  risksDescription   String    @map("risks_description") @db.Text
  patientSignature   String?   @map("patient_signature") @db.Text
  documentHash       String?   @map("document_hash") @db.VarChar(64)
  signerIp           String?   @map("signer_ip") @db.VarChar(45)
  otpCode            String?   @map("otp_code") @db.VarChar(10)
  isSigned           Boolean   @default(false) @map("is_signed")
  signedAt           DateTime? @map("signed_at") @db.Timestamptz
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  clinicalRecord     ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])

  @@map("informed_consents")
}

model Prescription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalRecordId   String    @map("clinical_record_id") @db.Uuid
  doctorId           String    @map("doctor_id") @db.Uuid
  items              Json      // Medicamentos prescritos
  instructions       String?   @db.Text
  qrVerificationCode String    @unique @map("qr_verification_code") @db.VarChar(100)
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  clinicalRecord     ClinicalRecord @relation(fields: [clinicalRecordId], references: [id])
  doctor             User           @relation("DoctorPrescriptions", fields: [doctorId], references: [id])

  @@map("prescriptions")
}

// ==========================================
// 3. SUBDOMINIO: AGENDA Y CITAS
// ==========================================

model Appointment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  doctorId        String    @map("doctor_id") @db.Uuid
  chairId         String    @map("chair_id") @db.Uuid
  startDateTime   DateTime  @map("start_date_time") @db.Timestamptz
  endDateTime     DateTime  @map("end_date_time") @db.Timestamptz
  status          String    @default("PROGRAMADO") @db.VarChar(30) // PROGRAMADO, CONFIRMADO, EN_SALA, EN_ATENCION, ATENDIDO, CANCELADO, NO_SHOW
  reason          String?   @db.VarChar(255)
  waitingMinutes  Int       @default(0) @map("waiting_minutes")
  reminderSent48h Boolean   @default(false) @map("reminder_sent_48h")
  reminderSent24h Boolean   @default(false) @map("reminder_sent_24h")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  branch  Branch      @relation(fields: [branchId], references: [id])
  patient Patient     @relation(fields: [patientId], references: [id])
  doctor  User        @relation("DoctorAppointments", fields: [doctorId], references: [id])
  chair   DentalChair @relation(fields: [chairId], references: [id])
  invoices Invoice[]
  discharges InventoryDischarge[]
  treatmentPlanItems TreatmentPlanItem[]
  settlementItems    DoctorSettlementItem[]

  @@map("appointments")
}

// ==========================================
// 4. SUBDOMINIO: FACTURACIÓN Y CAJA CIEGA
// ==========================================

model CashShift {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId             String    @map("branch_id") @db.Uuid
  cashierId            String    @map("cashier_id") @db.Uuid
  openingTime          DateTime  @default(now()) @map("opening_time") @db.Timestamptz
  closingTime          DateTime? @map("closing_time") @db.Timestamptz
  openingBalance       Decimal   @map("opening_balance") @db.Decimal(12, 2)
  theoreticalBalance   Decimal?  @map("theoretical_balance") @db.Decimal(12, 2)
  declaredPhysicalBalance Decimal? @map("declared_physical_balance") @db.Decimal(12, 2)
  discrepancy          Decimal?  @db.Decimal(12, 2)
  status               String    @default("ABIERTA") @db.VarChar(20) // ABIERTA, CERRADA_CIEGA, AUDITADA
  notes                String?   @db.Text
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz

  branch  Branch @relation(fields: [branchId], references: [id])
  cashier User   @relation("CashierShifts", fields: [cashierId], references: [id])

  @@map("cash_shifts")
}

model Invoice {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String?  @map("appointment_id") @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  cashierId    String    @map("cashier_id") @db.Uuid
  invoiceType  String    @map("invoice_type") @db.VarChar(30) // FACTURA, BOLETA, NOTA_CREDITO
  seriesNumber String    @unique @map("series_number") @db.VarChar(50)
  subtotal     Decimal   @db.Decimal(12, 2)
  tax          Decimal   @db.Decimal(12, 2)
  total        Decimal   @db.Decimal(12, 2)
  fiscalStatus String    @default("EMITIDO") @map("fiscal_status") @db.VarChar(30)
  cufeCae      String?   @map("cufe_cae") @db.VarChar(100)
  xmlUrl       String?   @map("xml_url") @db.VarChar(255)
  pdfUrl       String?   @map("pdf_url") @db.VarChar(255)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  patient        Patient         @relation(fields: [patientId], references: [id])
  cashier        User            @relation("CashierInvoices", fields: [cashierId], references: [id])
  paymentDetails PaymentDetail[]
  settlementItems DoctorSettlementItem[]

  @@map("invoices")
}

model PaymentDetail {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String    @map("invoice_id") @db.Uuid
  paymentMethod   String    @map("payment_method") @db.VarChar(30) // EFECTIVO, TARJETA, TRANSFERENCIA
  amount          Decimal   @db.Decimal(12, 2)
  voucherReference String?  @map("voucher_reference") @db.VarChar(100)
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_details")
}

// ==========================================
// 5. SUBDOMINIO: AUDITORÍA FORENSE APPEND-ONLY
// ==========================================

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  userRole       String?  @map("user_role") @db.VarChar(50)
  action         String   @db.VarChar(50) // LOGIN, READ, WRITE, UPDATE, SOFT_DELETE, EXPORT
  resource       String   @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.Uuid
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  eventTimestamp DateTime @default(now()) @map("event_timestamp") @db.Timestamptz
  metadata       Json?
  integrityHash  String?  @map("integrity_hash") @db.VarChar(64) // SHA-256

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ==========================================
// 6. SUBDOMINIO: INVENTARIO, LOTES Y RECETAS
// ==========================================

model ProcedureCatalog {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String   @db.VarChar(50)
  name                String   @db.VarChar(150)
  category            String   @db.VarChar(50) // Operatoria, Cirugía, Endodoncia, Periodoncia, Ortodoncia, Rehabilitación
  basePrice           Decimal  @map("base_price") @db.Decimal(10, 2)
  suggestedLabCost    Decimal  @default(0) @map("suggested_lab_cost") @db.Decimal(10, 2)
  durationMinutes     Int      @default(30) @map("duration_minutes")
  isActive            Boolean  @default(true) @map("is_active")
  isDeleted           Boolean  @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  recipes             ProcedureRecipe[]
  discharges          InventoryDischarge[]
  planItems           TreatmentPlanItem[]
  commissionRules     DoctorCommissionRule[]
  settlementItems     DoctorSettlementItem[]

  @@map("procedure_catalog")
}

model ClinicalSupply {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku          String   @db.VarChar(50)
  name         String   @db.VarChar(150)
  brand        String?  @db.VarChar(100)
  unit         String   @db.VarChar(50) // Cartucho, Gramo, Unidad, Par, Frasco, Caja
  minStock     Int      @default(10) @map("min_stock")
  currentStock Int      @default(0) @map("current_stock")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  batches      SupplyBatch[]
  recipes      ProcedureRecipe[]
  discharges   InventoryDischarge[]

  @@map("clinical_supplies")
}

model SupplyBatch {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplyId          String   @map("supply_id") @db.Uuid
  batchNumber       String   @map("batch_number") @db.VarChar(50)
  expirationDate    DateTime @map("expiration_date") @db.Timestamptz
  initialQuantity   Int      @map("initial_quantity")
  availableQuantity Int      @map("available_quantity")
  unitCost          Decimal  @map("unit_cost") @db.Decimal(10, 2)
  isDeleted         Boolean  @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  supply            ClinicalSupply       @relation(fields: [supplyId], references: [id])
  discharges        InventoryDischarge[]

  @@map("supply_batches")
}

model ProcedureRecipe {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  procedureId  String   @map("procedure_id") @db.Uuid
  supplyId     String   @map("supply_id") @db.Uuid
  quantity     Decimal  @db.Decimal(10, 2)

  procedure    ProcedureCatalog @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  supply       ClinicalSupply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@unique([procedureId, supplyId])
  @@map("procedure_recipes")
}

model InventoryDischarge {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId  String?  @map("appointment_id") @db.Uuid
  chairId        String?  @map("chair_id") @db.Uuid
  procedureId    String?  @map("procedure_id") @db.Uuid
  supplyId       String   @map("supply_id") @db.Uuid
  batchId        String?  @map("batch_id") @db.Uuid
  quantity       Decimal  @db.Decimal(10, 2)
  reason         String   @db.VarChar(150)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  appointment    Appointment?      @relation(fields: [appointmentId], references: [id])
  procedure      ProcedureCatalog? @relation(fields: [procedureId], references: [id])
  supply         ClinicalSupply    @relation(fields: [supplyId], references: [id])
  batch          SupplyBatch?      @relation(fields: [batchId], references: [id])

  @@map("inventory_discharges")
}



// ==========================================
// 6. SUBDOMINIO: PRESUPUESTOS MULTINIVEL Y COMISIONES (SPRINT 10)
// ==========================================

model TreatmentPlan {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  doctorId        String    @map("doctor_id") @db.Uuid
  planCode        String    @unique @map("plan_code") @db.VarChar(50)
  title           String    @db.VarChar(150)
  description     String?   @db.Text
  status          String    @default("BORRADOR") @db.VarChar(30) // BORRADOR, EMITIDO, APROBADO, RECHAZADO, VENCIDO
  isAlternative   Boolean   @default(false) @map("is_alternative")
  totalAmount     Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  issuedAt        DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz // RN-04: Validez de 30 días calendario
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason") @db.VarChar(255)
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  patient         Patient              @relation(fields: [patientId], references: [id])
  doctor          User                 @relation("DoctorTreatmentPlans", fields: [doctorId], references: [id])
  phases          TreatmentPlanPhase[]

  @@map("treatment_plans")
}

model TreatmentPlanPhase {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  phaseNumber Int      @map("phase_number") // 1: Higiene, 2: Operatorias, 3: Rehabilitación
  name        String   @db.VarChar(100)
  status      String   @default("PENDIENTE") @db.VarChar(30) // PENDIENTE, EN_PROCESO, COMPLETADA
  orderIndex  Int      @default(1) @map("order_index")
  subtotal    Decimal  @default(0) @db.Decimal(12, 2)

  plan        TreatmentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  items       TreatmentPlanItem[]

  @@map("treatment_plan_phases")
}

model TreatmentPlanItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phaseId         String   @map("phase_id") @db.Uuid
  procedureId     String   @map("procedure_id") @db.Uuid
  toothNumber     Int?     @map("tooth_number")
  surface         String?  @db.VarChar(20)
  quantity        Int      @default(1)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  labCost         Decimal  @default(0) @map("lab_cost") @db.Decimal(10, 2)
  finalPrice      Decimal  @map("final_price") @db.Decimal(10, 2)
  status          String   @default("PENDIENTE") @db.VarChar(30) // PENDIENTE, APROBADO, AGENDADO, COMPLETADO, CANCELADO
  appointmentId   String?  @map("appointment_id") @db.Uuid
  orderIndex      Int      @default(1) @map("order_index")

  phase           TreatmentPlanPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  procedure       ProcedureCatalog   @relation(fields: [procedureId], references: [id])
  appointment     Appointment?       @relation(fields: [appointmentId], references: [id])

  @@map("treatment_plan_items")
}

model DoctorCommissionRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  procedureId String?  @map("procedure_id") @db.Uuid
  ruleType    String   @default("PERCENTAGE_NET") @map("rule_type") @db.VarChar(30) // PERCENTAGE_NET, FIXED_AMOUNT
  percentage  Decimal? @db.Decimal(5, 2)
  fixedAmount Decimal? @map("fixed_amount") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  doctor      User              @relation(fields: [doctorId], references: [id])
  procedure   ProcedureCatalog? @relation(fields: [procedureId], references: [id])

  @@map("doctor_commission_rules")
}

model DoctorCommissionSettlement {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementCode       String    @unique @map("settlement_code") @db.VarChar(50)
  doctorId             String    @map("doctor_id") @db.Uuid
  periodStart          DateTime  @map("period_start") @db.Date
  periodEnd            DateTime  @map("period_end") @db.Date
  totalProceduresCount Int       @default(0) @map("total_procedures_count")
  grossAmount          Decimal   @default(0) @map("gross_amount") @db.Decimal(12, 2)
  totalLabCosts        Decimal   @default(0) @map("total_lab_costs") @db.Decimal(12, 2) // RN-07: Deducción previa obligatoria
  netCommissionableBase Decimal  @default(0) @map("net_commissionable_base") @db.Decimal(12, 2)
  netCommissionPaid    Decimal   @default(0) @map("net_commission_paid") @db.Decimal(12, 2)
  status               String    @default("PENDIENTE") @db.VarChar(30) // PENDIENTE, APROBADO, PAGADO, ANULADO
  paidAt               DateTime? @map("paid_at") @db.Timestamptz
  notes                String?   @db.VarChar(255)
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  doctor               User                   @relation(fields: [doctorId], references: [id])
  items                DoctorSettlementItem[]

  @@map("doctor_commission_settlements")
}

model DoctorSettlementItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId       String   @map("settlement_id") @db.Uuid
  appointmentId      String?  @map("appointment_id") @db.Uuid
  procedureId        String   @map("procedure_id") @db.Uuid
  invoiceId          String?  @map("invoice_id") @db.Uuid
  procedurePrice     Decimal  @map("procedure_price") @db.Decimal(10, 2)
  labCost            Decimal  @default(0) @map("lab_cost") @db.Decimal(10, 2) // RN-07: Costo deducido de lab
  commissionableBase Decimal  @map("commissionable_base") @db.Decimal(10, 2)
  commissionRate     Decimal  @map("commission_rate") @db.Decimal(5, 2)
  doctorEarning      Decimal  @map("doctor_earning") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  settlement         DoctorCommissionSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  appointment        Appointment?               @relation(fields: [appointmentId], references: [id])
  procedure          ProcedureCatalog           @relation(fields: [procedureId], references: [id])
  invoice            Invoice?                   @relation(fields: [invoiceId], references: [id])

  @@map("doctor_settlement_items")
}
